-> list[dict[str, Any]]:        """????? (Task 5 ??: ?? SQLiteBM25Index
+ JOIN memories)?        session_id: ???????? (None=??)?        ?????
search: [{"id", "memory", "score", "metadata", "created_at"}]        """
kw_scores = self._keyword_index.retrieve(query, limit=top_k * 2)
if not kw_scores:            return []        results: list[dict[str,
Any]] = []        for doc_id, score in kw_scores.items():
with self._lock:                if session_id is not None:
row = self.conn.execute(                        "SELECT content,
# metadata, created_at, user_id FROM memories "
"WHERE id=? AND is_deleted=0 AND session_id=?",
(doc_id, session_id),                    ).fetchone()
else:                    row = self.conn.execute(
"SELECT content, metadata, created_at, user_id FROM memories WHERE id=?
AND is_deleted=0",                        (doc_id,),
).fetchone()            if row and row[3] == user_id:
content, metadata_json, created_at, _ = row
results.append(                    {                        "id":
doc_id,                        "memory": content,
"score": score,                        "metadata":
json.loads(metadata_json) if metadata_json else {},
"created_at": created_at,                    }                )
return results[:top_k]    #
