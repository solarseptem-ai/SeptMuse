).fetchone()                else:                    row =
self.conn.execute(                        "SELECT content, metadata,
created_at FROM memories "                        "WHERE id=? AND
is_deleted=0 AND (state = 'active' OR state IS NULL)",
(vr.id,),                    ).fetchone()            if row:
content, metadata_json, created_at = row                results.append(
{                        "id": vr.id,                        "memory":
content,                        "score": vr.score,
"metadata": json.loads(metadata_json) if metadata_json else {},
