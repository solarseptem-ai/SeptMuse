jsonimport osimport sysfrom pathlib import Pathdef
_resolve_db_path(db_path: str | None) -> str:    """?? SQLite ??: ?? >
???? > ?? ~/.septmuse/septmuse.db?"""    if db_path:        return
db_path    env = os.getenv("SEPTMUSE_DB_PATH")    if env:        return
env    return str(Path.home() / ".septmuse" / "septmuse.db")def
_make_memory(db_path: str | None):    """?? Memory ?? (?? HashEmbedder,
?????)?"""    from septmuse import Memory, MemoryConfig    from
septmuse.providers.embedders.hash import HashEmbedder    path =
_resolve_db_path(db_path)    return
Memory(config=MemoryConfig(db_path=path), embedder=HashEmbedder())def
