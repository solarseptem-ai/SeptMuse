# ═══════════════════════════════════════════════════════════════════════
# SeptMuse Docker 环境变量模板
# 用法: cp .env.example .env → 编辑 .env → docker compose up
# ═══════════════════════════════════════════════════════════════════════

# ── API 认证 (未设=开发模式无认证, 已设=生产模式 401) ──
# SEPTMUSE_API_KEY=sk-your-secret-key

# ── LLM 推理 (启用 SEPTMUSE_INFER=true 时必填) ──
# SEPTMUSE_INFER=false
# SEPTMUSE_LLM=openai
# SEPTMUSE_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-openai-key
# 或 Anthropic:
# SEPTMUSE_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# 或 Ollama 本地:
# SEPTMUSE_LLM=ollama
# 或 DashScope (阿里云):
# SEPTMUSE_LLM=dashscope
# DASHSCOPE_API_KEY=sk-your-dashscope-key

# ── 嵌入模型 (hash=零配置, onnx=本地推理, st=sentence-transformers) ──
# SEPTMUSE_EMBEDDER=hash

# ── 重排器 (noop=透传, mmr=去冗余, cross_encoder=ONNX, llm=LLM 打分) ──
# SEPTMUSE_RERANKER=noop

# ── 数据库 (DB URL 已写在 compose 覆盖文件中, 无需在此配置) ──
# SQLite:     docker compose -f docker/docker-compose.yml up
# PostgreSQL: docker compose -f docker/docker-compose.yml -f docker/docker-compose.pg.yml up
# MySQL:      docker compose -f docker/docker-compose.yml -f docker/docker-compose.mysql.yml up